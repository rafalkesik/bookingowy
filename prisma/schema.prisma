// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Reservation {
  id          Int      @id @default(autoincrement())
  name        String
  platform    String
  guestAmount Int
  startDate   DateTime
  endDate     DateTime
  note        String
}

model User {
	id String @id
	name String
	email String @unique
	emailVerified Boolean
	image String?
	role String?
	banned Boolean?
	banReason String?
	banexpires DateTime?
	createdAt DateTime
	updatedAt DateTime
	@@map("user")

  session Session[]
  accounts Account[]
}

model Session {
	id String @id
	user User @relation(fields: [userId], references: [id])
	userId String
	token String @unique
	expiresAt DateTime
	ipAddress String?
	userAgent String?
	impersonatedBy String?
	createdAt DateTime
	updatedAt DateTime
	@@map("session")
}

model Account {
	id String @id
	user User @relation(fields: [userId], references: [id])
	userId String
	accountId String
	providerId String
	accessToken String?
	refreshToken String?
	accessTokenExpiresAt DateTime?
	refreshTokenExpiresAt DateTime?
	scope String?
	idToken String?
	password String?
	createdAt DateTime
	updatedAt DateTime
	@@map("account")
}

model Verification {
	id String @id
	identifier String
	value String
	expiresAt DateTime
	createdAt DateTime
	updatedAt DateTime
	@@map("verification")
}